# Release configuration for .github/workflows/testflight.yml
#
# The workflow itself is repo-agnostic; every project-specific value lives
# here. Sourced as a shell fragment, so keep it to plain KEY="value" lines.

# Path to the .xcodeproj or .xcworkspace, relative to the repo root.
XCODE_PROJECT="RubiksScramble/RubiksScramble.xcodeproj"

# Scheme to archive. This is the iOS host, not the watch app: Xcode has no
# App Store distribution method for a bare watchOS archive, so the watch app
# ships embedded in CubeScramble (the iPhone host). Must be marked "Shared"
# in Xcode and committed under <project>/xcshareddata/xcschemes/ — CI cannot
# see schemes in xcuserdata.
XCODE_SCHEME="CubeScramble"

# Archive destination: watchOS | iOS | macOS | visionOS | tvOS
PLATFORM="iOS"

# Optional. Path to a gitignored xcconfig the project references for
# DEVELOPMENT_TEAM; CI writes it from the APPLE_TEAM_ID secret before
# building. This project doesn't use one — the workflow passes
# DEVELOPMENT_TEAM on the xcodebuild command line instead.
TEAM_XCCONFIG=""

# Optional. Xcode 15.3+ wants "app-store-connect"; older Xcode wants
# "app-store". Defaults to app-store-connect.
EXPORT_METHOD="app-store-connect"

# Required. Signing is manual for archive and export alike: this
# certificate (from the APPLE_DIST_CERT_P12 secret) plus the App Store
# profiles below (from APPLE_PROVISIONING_PROFILES, a base64-encoded
# .tar.gz of .mobileprovision files). CI never uses automatic signing, so
# it never creates a certificate; the old automatic archive minted an
# "Apple Development: Created via API" certificate per run until the
# account hit Apple's cap.
SIGNING_CERTIFICATE="Apple Distribution"

# Semicolon-separated <bundle-id>=<profile-name> pairs, one per bundle
# in the archive — an embedded watch app needs its own entry. Each profile
# must be an App Store profile that includes the Apple Distribution
# certificate above; the workflow checks this before archiving.
PROVISIONING_PROFILES="com.pcintaiwan.scramblegen=ScrambleGen App Store;com.pcintaiwan.scramblegen.watch=ScrambleGen Watch App Store"
