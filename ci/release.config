# Release configuration for .github/workflows/testflight.yml
#
# The workflow itself is repo-agnostic; every project-specific value lives
# here. Sourced as a shell fragment, so keep it to plain KEY="value" lines.

# Path to the .xcodeproj or .xcworkspace, relative to the repo root.
XCODE_PROJECT="RubiksScramble/RubiksScramble.xcodeproj"

# Scheme to archive. The app is watch-only (WKWatchOnly, no iPhone app), but
# Xcode has no App Store distribution method for a bare watchOS archive, so
# the scheme archives CubeScramble: a code-less watch-only container
# (product type watchapp2-container, the same shape Xcode's "Watch App"
# template creates) that embeds the watch app. App Store Connect treats it
# as a watch-only app, so no iPhone screenshots or iPhone app review. Must
# be marked "Shared" in Xcode and committed under
# <project>/xcshareddata/xcschemes/ — CI cannot see schemes in xcuserdata.
XCODE_SCHEME="CubeScramble"

# Archive destination: watchOS | iOS | macOS | visionOS | tvOS
# iOS, not watchOS: the archived top-level product is the iOS-side
# container; the watch app is built for watchOS as its dependency.
PLATFORM="iOS"

# Optional. Path to a gitignored xcconfig the project references for
# DEVELOPMENT_TEAM; CI writes it from the APPLE_TEAM_ID secret before
# building. This project doesn't use one — the workflow passes
# DEVELOPMENT_TEAM on the xcodebuild command line instead.
TEAM_XCCONFIG=""

# Optional. Xcode 15.3+ wants "app-store-connect"; older Xcode wants
# "app-store". Defaults to app-store-connect.
EXPORT_METHOD="app-store-connect"

# Optional. Manual signing at export time. Leave both empty to let Xcode
# sign automatically through the API key ("cloud signing") — which only
# works if that key may manage distribution assets. An App Manager key
# can create development certificates but not distribution ones, and
# export then fails with "Cloud signing permission error". Filling these
# in also stops each run minting a fresh development certificate.
#
# The profiles themselves come from the APPLE_PROVISIONING_PROFILES
# secret: a base64-encoded .tar.gz of .mobileprovision files.
SIGNING_CERTIFICATE="Apple Distribution"

# Semicolon-separated <bundle-id>=<profile-name> pairs, one per bundle
# in the archive — the container and the watch app each need an entry.
PROVISIONING_PROFILES="com.pcintaiwan.scramblegen=ScrambleGen App Store;com.pcintaiwan.scramblegen.watch=ScrambleGen Watch App Store"
